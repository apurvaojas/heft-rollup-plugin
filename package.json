{
  "name": "@apurvaojas/heft-rollup-plugin",
  "version": "0.1.0",
  "description": "Heft plugin for Rollup",
  "repository": {
    "type": "git",
    "url": "https://github.com/apurvaojas/heft-rollup-plugin.git"
  },
  "homepage": "https://github.com/apurvaojas/heft-rollup-plugin",
  "main": "lib/index.js",
  "types": "dist/heft-rollup-plugin.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "heft build --clean && mkdir -p lib/schemas && cp src/schemas/*.json lib/schemas/",
    "test": "heft test --clean",
    "start": "heft test --clean --watch",
    "lint": "heft run --only lint || npx eslint src --ext .ts",
    "lint:fix": "npx eslint src --ext .ts --fix",
    "commit": "git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "semantic-release",
    "prepare": "husky",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "peerDependencies": {
    "@rushstack/heft": "^0.74.3",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "@rushstack/node-core-library": "^4.0.2",
    "@types/tapable": "1.0.6",
    "tapable": "1.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@rushstack/heft": "^0.74.3",
    "@rushstack/heft-jest-plugin": "^0.16.12",
    "@rushstack/heft-typescript-plugin": "^0.9.12",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "~9.25.1",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "rollup": "^4.0.0",
    "semantic-release": "^24.2.8",
    "typescript": "~5.4.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
