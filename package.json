{
  "name": "@apurvaojas/heft-rollup-plugin",
  "version": "0.1.0",
  "description": "Heft plugin for Rollup",
  "repository": {
    "type": "git",
    "url": "https://github.com/apurvaojas/heft-rollup-plugin.git"
  },
  "homepage": "https://github.com/apurvaojas/heft-rollup-plugin",
  "main": "lib/index.js",
  "types": "dist/heft-rollup-plugin.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "heft build --clean && mkdir -p lib/schemas && cp src/schemas/*.json lib/schemas/",
    "start": "heft test --clean --watch",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "peerDependencies": {
    "@rushstack/heft": "^0.74.3",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "@rushstack/node-core-library": "^4.0.2",
    "@types/tapable": "1.0.6",
    "tapable": "1.1.3"
  },
  "devDependencies": {
    "@rushstack/heft": "^0.74.3",
    "@rushstack/heft-typescript-plugin": "^0.9.12",
    "@types/node": "^18.15.0",
    "eslint": "~9.25.1",
    "rollup": "^4.0.0",
    "typescript": "~5.4.2"
  }
}
