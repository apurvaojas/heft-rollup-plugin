{
  "$schema": "https://developer.microsoft.com/json-schemas/heft/v0/heft-plugin.schema.json",

  "taskPlugins": [
    {
      "pluginName": "rollup-plugin",
      "entryPoint": "./lib/RollupPlugin",
      "optionsSchema": "./lib/schemas/heft-rollup-plugin.schema.json",

      "parameterScope": "rollup",
      "parameters": [
        {
          "longName": "--serve",
          "parameterKind": "flag",
          "description": "Start a local web server for testing purposes using rollup serve functionality. This parameter is only available when running in watch mode."
        }
      ]
    }
  ]
}